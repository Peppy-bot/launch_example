{
  deployments: [
    {
      source: {
        repo: "https://github.com/Peppy-bot/example_nodes.git",
        // Most of the time the AI brain is written in Python
        path: "python/fake_robot_brain",
        ref: "main"
      },
      // Example if this was an url
      // source: {
      //   url: "https://example.com/fake_robot_brain.tar.zst",
      // },
      // Example if this was a local path
      // source: {
      //   local: "./fake_robot_brain"
      // },
      instances: [
        {
          instance_id: "the_brain",
          arguments: {}
        }
      ],
    },
    {
      source: {
        repo: "https://github.com/Peppy-bot/example_nodes.git",
        path: "python/fake_openarm01_controller",
        ref: "main"
      },
      instances: [
        {
          instance_id: "the_nervous_system",
          arguments: {}
        }
      ]
    },
    {
      source: {
        repo: "https://github.com/Peppy-bot/example_nodes.git",
        path: "python/fake_uvc_camera",
        ref: "main"
      },
      instances: [
        {
          instance_id: "camera_front",
          arguments: {
            device: {
              physical: "/dev/video_right",
              sim: "mujoco:camera_right",
              priority: "physical"
            },
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "rgb",
            },
          }
        },
        {
          instance_id: "camera_rear",
          arguments: {
            device: {
              physical: "/dev/video_left",
              sim: "mujoco:camera_left",
              priority: "physical"
            },
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "rgb",
            },
          }
        }
      ]
    },
    {
      source: {
        repo: "https://github.com/Peppy-bot/example_nodes.git",
        path: "python/fake_video_reconstruction",
        ref: "main"
      },
      instances: [
        {
          instance_id: "video_reconstruction_1",
          arguments: {
            video_duration_seconds: 5
          }
        }
      ]
    },
  ]
}